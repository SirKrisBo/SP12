/* These are logic equations for the IC62 PAL from the SP1200 sampler. */
/* I created these equartions by observing the behaviour of the original PAL12H6. To use, simply write the jed file to a 16V8BQL GAL.*/
/* Alternatively, you can cope and paste the logic equations below into WinCupl and compile a jed file to write yourself. I used a TL866II programmer. */
/* This PAL, plus 24 x 8kb 6264 memory chips, is what's required to upgrade a non-turbo SP12 to a turbo SP12 */
Name     SP12_IC62_from_PAL12H6;
PartNo   IC62;
Date     24-Oct-2025;
Revision 4.0;
Designer Kris;
Device   g16v8a;

PIN 1   = C3MHZ;
PIN 2   = nUCK;
PIN 3   = UCNT0;
PIN 4   = UCNT1;
PIN 5   = UCNT2;
PIN 6   = nIORQ;
PIN 7   = nWR;
PIN 8   = nRD;
PIN 9   = A4;
PIN 10  = GND;
PIN 11  = A5;
PIN 12  = A6;
PIN 13  = nCESM;
PIN 14  = CSDISP;
PIN 15  = CSRADC;
PIN 16  = CSWADC;
PIN 17  = ENB138;
PIN 18  = SHSTB;
PIN 19  = A7;
PIN 20  = VCC;

FIELD UCNT = [UCNT2, UCNT1, UCNT0];

nCESM  = ( !C3MHZ & !nUCK & UCNT0 & !UCNT1 & UCNT2 & !nIORQ & !nWR & !A4 & !A5 &  A6 & !A7 )
       # (  C3MHZ &  nUCK & UCNT0 & !UCNT1 & UCNT2 & !nIORQ & !nWR & !A4 & !A5 &  A6 & !A7 );

CSDISP = ( !nIORQ & !nRD &  A5 & !A6 & A7 )
        # ( !nIORQ & !nWR &  A5 & !A6 & A7 );

CSRADC  = ( !nIORQ & !nRD & !A4 & !A5 &  A6 & A7 );

CSWADC  = ( !nIORQ & !nWR & !A4 & !A5 &  A6 & A7 );

ENB138  = ( !nIORQ & !nWR & !A5 & !A6 & A7 );

SHSTB   =   nUCK & C3MHZ & UCNT2
        #   !UCNT0 & !UCNT1 & !UCNT2
        #   UCNT1 & UCNT2
        #   UCNT0 & UCNT2;
